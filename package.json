  "devDependencies": {
    "@nx/eslint": "^21.6.11",
    "@nx/next": "21.6.11",
    "nx": "21.6.11",
    "syncpack": "^13.0.4"
  },
  "node": ">=22.0.0",
  "nx": {},
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "axios": "^1.19.0",
    "next": "16.2.12",
